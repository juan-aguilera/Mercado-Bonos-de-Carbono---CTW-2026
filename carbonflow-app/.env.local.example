# Supabase (https://supabase.com -> New project -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Global Forest Watch Data API (https://www.globalforestwatch.org/help/programs/gfw-pro/api/ -> self-service key)
GFW_API_KEY=

# Anthropic (chatbot de certificacion) https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Opcional: si el equipo confirma endpoints estables durante el bloque 0-2h,
# se pueden fijar aqui para que lib/integrations/registries.ts y runap.ts los usen directamente.
RUNAP_REGISTRY_API_URL=
VERRA_REGISTRY_API_URL=
GOLD_STANDARD_REGISTRY_API_URL=
RENARE_REGISTRY_API_URL=
